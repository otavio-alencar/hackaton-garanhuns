# Copie este arquivo para ".env" e preencha (o .env NUNCA vai para o git).
# Passo a passo de onde pegar cada valor: GUIA.md

# --- n8n ---
N8N_ENCRYPTION_KEY=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=        # chave "service_role" (secreta!)

# --- Google AI Studio (grátis): https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Portal da Transparência federal (opcional, grátis) ---
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=
