{
  "id": "painelTransp0001",
  "name": "Portal Transparência — Painel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "painel",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "name": "Pedido do painel (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "painel-transparencia"
    },
    {
      "parameters": {
        "jsCode": "// Valida o pedido antes de falar com o banco. Quem decide o acesso é a função painel() do Supabase.\nconst b = $input.first().json.body || $input.first().json;\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst user_id = String(b.user_id || '').trim();\nconst visao = String(b.visao || '').trim();\nconst valido = uuid.test(user_id) && ['cidadao', 'risco', 'governanca'].includes(visao);\nreturn [{ json: { valido, user_id, visao } }];"
      },
      "name": "Validar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valido",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Pedido válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/painel",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_user_id: $json.user_id, p_visao: $json.visao }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Consultar painel (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": "={{ $json.erro === 'sem_perfil' ? 401 : ($json.erro ? 403 : 200) }}"
        }
      },
      "name": "Responder painel",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ erro: 'pedido_invalido', mensagem: 'Pedido inválido.' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "name": "Responder inválido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        320
      ]
    },
    {
      "parameters": {
        "content": "### Painel dos dashboards\nRecebe {user_id, visao}. A função painel() do Supabase confere o perfil e só devolve dados da visão permitida (403 se negada, 401 se sem perfil).",
        "width": 700,
        "height": 130
      },
      "name": "Nota painel",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        20
      ]
    }
  ],
  "connections": {
    "Pedido do painel (Webhook)": {
      "main": [
        [
          {
            "node": "Validar pedido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar pedido": {
      "main": [
        [
          {
            "node": "Pedido válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pedido válido?": {
      "main": [
        [
          {
            "node": "Consultar painel (Supabase)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder inválido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar painel (Supabase)": {
      "main": [
        [
          {
            "node": "Responder painel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}